        <td>{r.nrMovimentiScarico} / {r.nrMovimentiCarico}</td>
        <td>{r.nrFIR}</td>
        <td>{r.pesoLordoScarichi?.toFixed(2) || 0}</td>
<td>{r.caloScarichi?.toFixed(2) || 0}</td>
{/* 🔥 NUOVO: Dati Tara Scarichi */}
<td>{r.taraScarichi?.toFixed(2) || 0}</td>
<td>{r.pesoNettoScarichi?.toFixed(2) || 0}</td>

<td>{r.pesoLordoCarichi?.toFixed(2) || 0}</td>
<td>{r.caloCarichi?.toFixed(2) || 0}</td>
{/* 🔥 NUOVO: Dati Tara Carichi */}
<td>{r.taraCarichi?.toFixed(2) || 0}</td>
<td>{r.pesoNettoCarichi?.toFixed(2) || 0}</td>

        <td>{r.costiTotali.toFixed(2)}</td>
        <td>{r.ricaviTotali.toFixed(2)}</td>
        {filtroUtente === "tutti" && <td>{r.utenti || r.utentiDelGiorno || "-"}</td>}
      </tr>    ))}
  </tbody>
</table>

{modalProspetto && (
  <div
    style={{
      position: "fixed",
      top: 0,
      left: 0,
      right: 0,
      bottom: 0,
      background: "rgba(0,0,0,0.6)",
      display: "flex",
      justifyContent: "center",
      alignItems: "center",
      zIndex: 99999,
      pointerEvents: salvataggioInCorso ? "auto" : "auto"
    }}
  >
    <div
      onClick={(e) => e.stopPropagation()}
      style={{
        background: "white",
        padding: 20,
        borderRadius: 10,
        width: "80%",
        maxHeight: "80vh",
        overflow: "auto",
        opacity: salvataggioInCorso ? 0.7 : 1,
        pointerEvents: salvataggioInCorso ? "none" : "auto"
      }}
    >
      <h3>
        {salvataggioInCorso
          ? "Salvataggio in corso..."
          : "Prospetto Fattura"}
      </h3>

      <table border="1" cellPadding="5" style={{ width: "100%", marginTop: 10 }}>
        <thead>
          <tr>
            <th>FIR</th>
            <th>CER</th>
            <th>Materiale</th>
            <th>Peso Lordo (Kg)</th>
            <th>Calo</th>
            <th>Tara (Kg)</th>
            <th>Netto (Kg)</th>
            <th>Prezzo €/Kg</th>
            <th>Totale €</th>
          </tr>
        </thead>

        <tbody>
          {prospettoRighe.map((r, i) => {
            const netto = round2(r.netto);
            const prezzo = money(r.prezzo);
            const tot = money(netto * prezzo);

            return (
              <tr key={i}>
                <td>{r.fir}</td>
                <td>{r.cer}</td>
                <td>{r.materiale}</td>
                <td>{round2(r.peso)}</td>
                <td>{round2(r.calo)}</td>
                <td>{round2(r.tara || 0)}</td>
                <td>{netto}</td>
                <td>{prezzo}</td>
                <td>{tot.toFixed(2)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <div style={{ marginTop: 20, display: "flex", gap: 10 }}>
        <button
          onClick={stampaSoloProspetto}
          disabled={salvataggioInCorso}
        >
          🖨 Stampa
        </button>

<button
  onClick={confermaSalvataggioProspetto}
  disabled={salvataggioInCorso}
>
  {salvataggioInCorso ? "⏳ Salvataggio..." : "💾 Salva"}
</button>


        <button
          onClick={() => setModalProspetto(false)}
          disabled={salvataggioInCorso}
        >
          ❌ Chiudi
        </button>
      </div>
    </div>
  </div>
)}


{modalData && (
  <div key={reloadKey} style={{
      position: "fixed",      top: 0,      left: 0,      width: "100vw",      height: "100vh",      background: "rgba(0,0,0,0.6)",      display: "flex",      justifyContent: "center",      alignItems: "center",      zIndex: 99999    }}  >
    <div      onClick={(e) => e.stopPropagation()}      style={{        background: "white",        padding: 20,        borderRadius: 10,        width: "80%",        maxHeight: "80vh",        overflowY: "auto",        boxShadow: "0 10px 30px rgba(0,0,0,0.3)"      }}    >
      <h2>
  {modalTipo === "prospetto"
    ? (
        documentoConsuntivato
          ? "📑 Prospetto Fattura (Pagata)"
          : "📑 Prospetto Fattura (Da Pagare)"
      )
    : (
        documentoConsuntivato
          ? "📄 Fattura (Pagata)"
          : "📄 Fattura (Da Pagare)"
      )}
</h2>
{!modalData.documentoEsistente && !documentoConsuntivato && (
  <div style={{
    marginBottom: "15px",
    display: "flex",
    gap: "10px",
    alignItems: "center",
    border: "1px solid #ddd",
    padding: "10px",
    borderRadius: "6px",
    background: "#f9f9f9"
  }}>
    <label>
      📊 Applica listino:
      <select
        value={listinoApplicato}
        onChange={async (e) => {
          const nuovoListino = e.target.value;

          setListinoApplicato(nuovoListino);

          if (nuovoListino === "tutti") {
            try {
              const movimentiOriginali = await Promise.all(
                pulitiIds.map(async (id) => {
                  const movimento = scarichi.find(m => m.id === id);

                  if (!movimento) {
                    return null;
                  }

                  const collectionMovimento =
                    movimento.tipo === "carico"
                      ? "carichi"
                      : "scarichi";

                  const field =
                    movimento.tipo === "carico"
                      ? "carico"
                      : "scarico";

                  const snap = await getDoc(
                    doc(db, collectionMovimento, id)
                  );

                  if (!snap.exists()) {
                    return movimento;
                  }

                  const data = snap.data();

                  return {
                    ...movimento,
                    cer: Array.isArray(data[field])
                      ? data[field]
                      : []
                  };
                })
              );

              setScarichi(prev =>
                prev.map(m => {
                  const originale = movimentiOriginali.find(
                    x => x && x.id === m.id
                  );

                  return originale || m;
                })
              );

            } catch (err) {
              console.error(
                "❌ ERRORE RIPRISTINO PREZZI ORIGINALI:",
                err
              );
            }

            return;
          }

          await applyListino({
            movimentiIds: pulitiIds,
            listino: nuovoListino,
            db,
            scarichi,
            setScarichi
          });
        }}
      >
        <option value="tutti">Nessuno</option>

        {Object.keys(listini)
          .filter(nome => {
            if (modalTipo === "prospetto") {
              return listini[nome]?.tipoListino === "SCARICO";
            }

            if (modalTipo === "fattura") {
              return listini[nome]?.tipoListino === "CARICO";
            }

            return true;
          })
          .map(nome => (
            <option key={nome} value={nome}>
              {nome}
            </option>
          ))}
      </select>
    </label>
  </div>
)}

<p><b>Cliente:</b> {modalData.cliente}</p>

{modalTipo === "fattura" && (
  <div style={{
    display: "grid",
    gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
    gap: 12,
    marginTop: 15,
    marginBottom: 20,
    padding: 15,
    border: "1px solid #ccc",
    borderRadius: 6
  }}>
    <h3 style={{ gridColumn: "1 / -1", margin: 0 }}>
      Dati fattura elettronica
    </h3>

    <label>
      Numero fattura
      <input
      disabled={documentoConsuntivato}
        type="text"
        value={modalData.numeroFattura || ""}
        onChange={e => setModalData(prev => ({
          ...prev,
          numeroFattura: e.target.value
        }))}
        style={{ display: "block", width: "100%", boxSizing: "border-box" }}
      />
    </label>


<label>
  Data fattura
  <input
    type="text"
    disabled={documentoConsuntivato}
    placeholder="GG/MM/AAAA"
    value={
      modalData.dataFattura
        ? (() => {
            const d =
              modalData.dataFattura instanceof Date
                ? modalData.dataFattura
                : modalData.dataFattura?.toDate
                ? modalData.dataFattura.toDate()
                : new Date(modalData.dataFattura);

            return Number.isNaN(d.getTime())
              ? ""
              : `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;
          })()
        : ""
    }
    onChange={e => {
      const valore = e.target.value;

      if (!valore) {
        setModalData(prev => ({
          ...prev,
          dataFattura: null
        }));
        return;
      }

      const match = valore.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!match) {
        setModalData(prev => ({
          ...prev,
          dataFatturaInput: valore
        }));
        return;
      }

      const giorno = Number(match[1]);
      const mese = Number(match[2]);
      const anno = Number(match[3]);
      const data = new Date(anno, mese - 1, giorno, 12, 0, 0);

      if (
        data.getFullYear() === anno &&
        data.getMonth() === mese - 1 &&
        data.getDate() === giorno
      ) {
        setModalData(prev => ({
          ...prev,
          dataFattura: data,
          dataFatturaInput: undefined
        }));
      }
    }}
    style={{ display: "block", width: "100%", boxSizing: "border-box" }}
  />
</label>



<label>
  Causale fattura elettronica
  <select
  disabled={documentoConsuntivato}
    value={modalData.tipoDocumento || "TD24"}
    onChange={e => setModalData(prev => ({
      ...prev,
      tipoDocumento: e.target.value
    }))}
    style={{ display: "block", width: "100%", boxSizing: "border-box" }}
  >
    <option value="TD01">TD01 - Fattura</option>
    <option value="TD02">TD02 - Acconto/anticipo su fattura</option>
    <option value="TD03">TD03 - Acconto/anticipo su parcella</option>
    <option value="TD05">TD05 - Nota di debito</option>
    <option value="TD06">TD06 - Parcella</option>
    <option value="TD16">TD16 - Integrazione fattura reverse charge interno</option>
    <option value="TD17">TD17 - Integrazione/autofattura per acquisto servizi dall'estero</option>
    <option value="TD18">TD18 - Integrazione per acquisto di beni intracomunitari</option>
    <option value="TD19">TD19 - Integrazione/autofattura per acquisto di beni ex art. 17 c. 2 DPR 633/72</option>
    <option value="TD20">TD20 - Autofattura per regolarizzazione/integrazione fattura</option>
    <option value="TD21">TD21 - Autofattura per splafonamento</option>
    <option value="TD22">TD22 - Estrazione beni da deposito IVA</option>
    <option value="TD23">TD23 - Estrazione beni da deposito IVA con versamento IVA</option>
    <option value="TD24">TD24 - Fattura differita di cui all'art. 21, comma 4, lett. a)</option>
    <option value="TD25">TD25 - Fattura differita di cui all'art. 21, comma 4, terzo periodo lett. b)</option>
    <option value="TD26">TD26 - Cessione di beni ammortizzabili e per passaggi interni</option>
    <option value="TD27">TD27 - Fattura per autoconsumo o cessioni gratuite senza rivalsa</option>
    <option value="TD29">TD29 - Comunicazione per omessa o irregolare fatturazione</option>
  </select>
</label>



<label>
  Natura IVA
  <select
  disabled={documentoConsuntivato}
    value={modalData.naturaIva || "N6.1"}
    onChange={e => {
      const natura = natureIvaOptions.find(
        opzione => opzione.value === e.target.value
      );

      setModalData(prev => ({
        ...prev,
        naturaIva: e.target.value,
        riferimentoNormativo: natura?.riferimento || ""
      }));
    }}
    style={{ display: "block", width: "100%", boxSizing: "border-box" }}
  >
    {natureIvaOptions.map(opzione => (
      <option key={opzione.value} value={opzione.value}>
        {opzione.label}
      </option>
    ))}
  </select>
</label>

<label style={{ gridColumn: "1 / -1" }}>
  Riferimento normativo IVA
  <input
  disabled={documentoConsuntivato}
    type="text"
    value={modalData.riferimentoNormativo || ""}
    onChange={e => setModalData(prev => ({
      ...prev,
      riferimentoNormativo: e.target.value
    }))}
    style={{ display: "block", width: "100%", boxSizing: "border-box" }}
  />
</label>


    <label>
      Condizioni di pagamento
      <select
      disabled={documentoConsuntivato}
        value={modalData.condizioniPagamento || "TP02"}
        onChange={e => setModalData(prev => ({
          ...prev,
          condizioniPagamento: e.target.value
        }))}
        style={{ display: "block", width: "100%", boxSizing: "border-box" }}
      >
