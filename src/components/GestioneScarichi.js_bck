        <option value="TP02">TP02 - Pagamento completo</option>
        <option value="TP03">TP03 - Anticipo</option>
      </select>
    </label>

    <label>
      Modalità di pagamento
      <select
      disabled={documentoConsuntivato}
        value={modalData.modalitaPagamento || "MP05"}
        onChange={e => setModalData(prev => ({
          ...prev,
          modalitaPagamento: e.target.value
        }))}
        style={{ display: "block", width: "100%", boxSizing: "border-box" }}
      >
        <option value="MP01">MP01 - Contanti</option>
        <option value="MP02">MP02 - Assegno</option>
        <option value="MP05">MP05 - Bonifico</option>
        <option value="MP08">MP08 - Carta di pagamento</option>
        <option value="MP12">MP12 - RIBA</option>
        <option value="MP19">MP19 - RID</option>
      </select>
    </label>
<label>
  Banca di accredito
  <select
  disabled={documentoConsuntivato}
    value={
      (modalData.banca || modalData.bancaPredefinita)?.id || ""
    }
    onChange={e => {
      const bancaSelezionata =
        (modalData.bancheAttive || []).find(
          b => b.id === e.target.value
        ) || null;

      setModalData(prev => ({
        ...prev,
        banca: bancaSelezionata
      }));
    }}
    style={{
      display: "block",
      width: "100%",
      boxSizing: "border-box"
    }}
  >
    <option value="">Seleziona banca</option>

    {(modalData.bancheAttive || []).map(banca => (
      <option key={banca.id} value={banca.id}>
        {banca.nome || banca.intestatario || banca.banca || banca.id}
        {banca.iban ? ` - ${banca.iban}` : ""}
      </option>
    ))}
  </select>
</label>


<label>
  Data scadenza pagamento
  <input
    disabled={documentoConsuntivato}
    type="text"
    placeholder="GG/MM/AAAA"
    value={
      modalData.dataScadenzaPagamento
        ? (() => {
            const d =
              modalData.dataScadenzaPagamento instanceof Date
                ? modalData.dataScadenzaPagamento
                : modalData.dataScadenzaPagamento?.toDate
                ? modalData.dataScadenzaPagamento.toDate()
                : new Date(modalData.dataScadenzaPagamento);

            return Number.isNaN(d.getTime())
              ? ""
              : `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;
          })()
        : ""
    }
    onChange={e => {
      const valore = e.target.value;

      if (!valore) {
        setModalData(prev => ({
          ...prev,
          dataScadenzaPagamento: null
        }));
        return;
      }

      const match = valore.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!match) {
        setModalData(prev => ({
          ...prev,
          dataScadenzaPagamentoInput: valore
        }));
        return;
      }

      const giorno = Number(match[1]);
      const mese = Number(match[2]);
      const anno = Number(match[3]);
      const data = new Date(anno, mese - 1, giorno, 12, 0, 0);

      if (
        data.getFullYear() === anno &&
        data.getMonth() === mese - 1 &&
        data.getDate() === giorno
      ) {
        setModalData(prev => ({
          ...prev,
          dataScadenzaPagamento: data,
          dataScadenzaPagamentoInput: undefined
        }));
      }
    }}
    style={{ display: "block", width: "100%", boxSizing: "border-box" }}
  />
</label>

  </div>
)}

<table border="1" cellPadding="5" style={{ width: "100%", marginTop: 10 }}>
  <thead>
    <tr>
      <th>Materiale</th>
      <th>Peso Lordo (Kg)</th>
      <th>Calo</th>
      <th>Tara (Kg)</th>
      <th>Netto (Kg)</th>
      <th>Prezzo €/Kg</th>
      <th>Totale €</th>
    </tr>
  </thead>
  <tbody>
    {(() => {
      const movs = scarichi.filter(m =>
        modalData.movimentiIds.includes(m.id)
      );

      console.group("🧾 MODAL RENDER DEBUG");
      console.log("modalTipo:", modalTipo);
      console.log("movimentiIds:", modalData.movimentiIds);
      console.log("movimenti trovati:", movs.length);

      movs.forEach(m => {
        console.log("➡️ MOVIMENTO:", {
          id: m.id,
          tipo: m.tipo,
          cerCount: m.cer?.length || 0,
          movimentoFinanziarioId: m.movimentoFinanziarioId
        });

        (m.cer || []).forEach(c => {
          console.log("   FIR:", c.fir);
          console.log("   CER:", c.cer || c.codiceCER);
          console.log("   RIGHE COUNT:", c.righe?.length || 0);
        });
      });

      console.groupEnd();
      return movs;
    })()
      .filter(m => {
        if (modalTipo === "prospetto") return m.tipo === "scarico";
        if (modalTipo === "fattura") return m.tipo === "carico";
        return true;
      })
      .flatMap(m =>
        (m.cer || []).map(c => ({
          fir: c.fir || m.fir || "-",
          cer: c.cer || c.codiceCER || "-",
          tipo: m.tipo,
          righe: c.righe || []
        }))
      )
      .map((b, i) => (
        <React.Fragment key={i}>
          <tr>
            <td
              colSpan="7"
              style={{ background: "#eee", fontWeight: "bold" }}
            >
              FIR: {b.fir} | CER: {b.cer}
            </td>
          </tr>

          {b.righe.map((r, j) => {
            const { peso, calo, caloKg, tara, netto, prezzo, tot } =
              calcolaRiga(r, b.tipo);

            const caloLabel =
              r.caloTipo === "perc"
                ? `${calo}% (${caloKg} Kg)`
                : `${caloKg} Kg`;

            return (
              <tr key={j}>
                <td>{r.materiale}</td>
                <td>{peso.toFixed(2)}</td>
                <td>{caloLabel}</td>
                <td>{tara.toFixed(2)}</td>
                <td>{netto.toFixed(2)}</td>
                <td>{prezzo.toFixed(2)}</td>
                <td>{tot.toFixed(2)}</td>
              </tr>
            );
          })}
        </React.Fragment>
      ))}
  </tbody>
</table>


<h3 style={{ marginTop: 20 }}>
  Totale: {(() => {
    const movs = scarichi
      .filter(m => modalData.movimentiIds.includes(m.id))
      .filter(m => {
        if (modalTipo === "prospetto") return m.tipo === "scarico";
        if (modalTipo === "fattura") return m.tipo === "carico";
        return true;
      });

    return round2(
      movs.reduce((tot, m) =>
        tot + (m.cer || []).reduce((t2, c) =>
          t2 + (c.righe || []).reduce(
            (t3, r) => t3 + calcolaRiga(r, m.tipo).tot,
            0
          ),
        0),
      0)
    ).toFixed(2);
  })()}
</h3>


{(
  modalTipo === "fattura"
    ? !documentoConsuntivato
    : !modalData.documentoEsistente
) && (
  <div style={{ marginTop: 10, marginBottom: 10 }}>
    <div style={{ fontWeight: "bold", marginBottom: 5 }}>
      Salva il movimento pagabile dal:
    </div>
    <DatePicker
      selected={dataSalvataggio}
      onChange={(date) => setDataSalvataggio(date)}
      minDate={minDataSalvataggio}
      maxDate={new Date()}
      dateFormat="dd/MM/yyyy"
    />
  </div>
)}
      <div style={{ marginTop: 20 }}>



{(
  modalTipo === "fattura"
    ? !documentoConsuntivato
    : !modalData.documentoEsistente
) && (
  <>
    <button
      onClick={handleSalvaDocumento}
      disabled={salvataggioInCorso}
      style={{
        opacity: salvataggioInCorso ? 0.5 : 1,
        cursor: salvataggioInCorso ? "not-allowed" : "pointer",
      }}
    >
      {salvataggioInCorso
        ? "Salvataggio in corso..."
        : modalTipo === "fattura"
          ? "Salva fattura"
          : "Salva prospetto"}
    </button>

    {modalTipo === "fattura" && (
      <button
        onClick={handleGeneraXmlFattura}
        style={{ marginLeft: 10 }}
      >
        Genera XML FatturaPA
      </button>
    )}
  </>
)}

        <button onClick={handleStampaDocumento} style={{ marginLeft: 10 }}>          🖨️ Stampa        </button>
        <button          onClick={() => setModalData(null)}          style={{ marginLeft: 10 }}        >          ❌ Chiudi        </button>
      </div>
    </div>
  </div>
)}
    </div>
  );
};
export default GestioneScarichi;