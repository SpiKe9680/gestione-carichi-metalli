/* METALFLOW | Gestione Carichi / Scarichi
   Foglio UI: non modifica la logica applicativa. */

.gestione-scarichi-container {
  --mf-primary: #1e5a80;
  --mf-primary-hover: #174664;
  --mf-primary-soft: #edf4f8;
  --mf-border: #d5e0e7;
  --mf-text: #263746;
  --mf-muted: #64748b;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  padding: clamp(14px, 2.2vw, 28px);
  color: var(--mf-text);
  background: #f4f7fa;
  font-family: Inter, "Segoe UI", Roboto, Arial, sans-serif;
  line-height: 1.45;
}
.gestione-scarichi-container *,
.gestione-scarichi-container *::before,
.gestione-scarichi-container *::after { box-sizing: border-box; }
.gestione-scarichi-container h1,
.gestione-scarichi-container h2,
.gestione-scarichi-container h3,
.gestione-scarichi-container h4 { color: #18384e; line-height: 1.25; }
.gestione-scarichi-container h2 { margin: 0; font-size: clamp(1.35rem, 2vw, 1.8rem); font-weight: 750; letter-spacing: -.025em; }
.gestione-scarichi-container h3 { font-size: 1.08rem; }
.gestione-scarichi-container button,
.gestione-scarichi-container input,
.gestione-scarichi-container select,
.gestione-scarichi-container textarea { font: inherit; }
.gestione-scarichi-container button { transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
.gestione-scarichi-container button:focus-visible,
.gestione-scarichi-container input:focus-visible,
.gestione-scarichi-container select:focus-visible { outline: 2px solid #3b82a8; outline-offset: 2px; }

/* Intestazione */
.gestione-scarichi-container .scarichi-brand {
  display: flex; align-items: center; gap: 16px; width: 100%;
  margin: 0 0 20px; padding: 18px 22px;
  border: 1px solid #dbe5ec; border-radius: 14px;
  background: linear-gradient(135deg, #fff 0%, #f3f8fb 100%);
  box-shadow: 0 4px 16px rgba(22, 55, 78, .06);
}
.gestione-scarichi-container .scarichi-logo { display: block; width: auto; max-width: 86px; max-height: 64px; object-fit: contain; }
.gestione-scarichi-container .scarichi-title { margin: 0; }

/* Barra comandi */
.gestione-scarichi-container .gestione-scarichi-toolbar {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px;
  width: 100%; margin: 0 0 18px;
}
.gestione-scarichi-container .gestione-scarichi-toolbar button,
.gestione-scarichi-container .filtri > button.filter-item {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; min-width: 0; min-height: 44px; margin: 0; padding: 10px 14px;
  border: 1px solid var(--mf-primary); border-radius: 9px;
  background: var(--mf-primary); color: #fff; font-size: 14px; font-weight: 650;
  text-align: center; cursor: pointer;
}
.gestione-scarichi-container .gestione-scarichi-toolbar button:hover:not(:disabled),
.gestione-scarichi-container .filtri > button.filter-item:hover { background: var(--mf-primary-hover); border-color: var(--mf-primary-hover); box-shadow: 0 3px 8px #1e5a8024; }
.gestione-scarichi-container .gestione-scarichi-toolbar button:disabled { opacity: .5; cursor: not-allowed; }
.gestione-scarichi-container .gestione-scarichi-toolbar button.toolbar-logout { background: #a83232; border-color: #a83232; }
.gestione-scarichi-container .gestione-scarichi-toolbar button.toolbar-logout:hover:not(:disabled) { background: #862727; border-color: #862727; }

/* Legenda */
.gestione-scarichi-container .scarichi-legend {
  display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px !important;
  margin: 0 0 16px !important; padding: 12px 15px;
  border: 1px solid var(--mf-border); border-radius: 10px; background: #fff;
  color: #435668; font-size: 13px !important;
}
.gestione-scarichi-container .scarichi-legend > div { display: inline-flex; align-items: center; gap: 7px !important; }
.gestione-scarichi-container .scarichi-legend > div > div { flex: 0 0 14px; width: 14px !important; height: 14px !important; border-radius: 4px; }

/* Filtri */
.gestione-scarichi-container > button.filter-item {
  display: inline-flex; align-items: center; justify-content: center; min-height: 42px;
  margin: 0 0 12px !important; padding: 10px 16px; border: 1px solid var(--mf-primary);
  border-radius: 9px; background: var(--mf-primary); color: #fff; font-weight: 650; cursor: pointer;
}
.gestione-scarichi-container > button.filter-item:hover { background: var(--mf-primary-hover); }
.gestione-scarichi-container .filtri-attivi-card {
  display: block; width: 100%; margin: 0 0 18px; padding: 15px 18px;
  border: 1px solid #d1e0e9; border-radius: 12px; background: #fff;
  color: var(--mf-text); cursor: pointer; overflow-wrap: anywhere;
  box-shadow: 0 3px 12px rgba(22,55,78,.04); transition: border-color .18s, background .18s;
}
.gestione-scarichi-container .filtri-attivi-card:hover { background: #f5f9fc; border-color: var(--mf-primary); }
.gestione-scarichi-container .filtri-attivi-card:focus-visible { outline: 2px solid var(--mf-primary); outline-offset: 2px; }
.gestione-scarichi-container .filtri-attivi-titolo { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 7px; color: var(--mf-primary); }
.gestione-scarichi-container .filtri-attivi-titolo span { font-size: 13px; font-weight: 650; }
.gestione-scarichi-container .filtri-attivi-valori { color: #506273; font-size: 13px; line-height: 1.65; overflow-wrap: anywhere; }
.gestione-scarichi-container .filtri {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 16px;
  width: 100%; margin: 0 0 20px; padding: 18px;
  border: 1px solid var(--mf-border); border-radius: 12px; background: #fff;
  box-shadow: 0 3px 12px rgba(22,55,78,.035);
}
.gestione-scarichi-container .filtri > * { min-width: 0; max-width: 100%; }
.gestione-scarichi-container .filtri > div { width: 100%; min-width: 0; }
.gestione-scarichi-container .filtri label.filter-item {
  display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 7px;
  width: 100%; min-width: 0; margin: 0; padding: 0; color: #334b5d; font-size: 13px; font-weight: 650;
}
.gestione-scarichi-container .filtri label.filter-item:has(input[type="checkbox"]) { flex-direction: row; align-items: center; gap: 9px; min-height: 42px; }
.gestione-scarichi-container .filtri input[type="checkbox"] { flex: 0 0 17px; width: 17px; height: 17px; margin: 0; accent-color: var(--mf-primary); }
.gestione-scarichi-container .filtri input[type="text"],
.gestione-scarichi-container .filtri select,
.gestione-scarichi-container .filtri .react-datepicker-wrapper input {
  display: block; width: 100%; min-width: 0; max-width: 100%; min-height: 42px; margin: 0; padding: 9px 11px;
  border: 1px solid #cbd5df; border-radius: 8px; background: #fff; color: #263746; font-size: 14px;
}
.gestione-scarichi-container .filtri input:focus,
.gestione-scarichi-container .filtri select:focus,
.gestione-scarichi-container .filtri .react-datepicker-wrapper input:focus { outline: none; border-color: var(--mf-primary); box-shadow: 0 0 0 3px rgba(30,90,128,.11); }
.gestione-scarichi-container .filtri label.filter-item > div { width: 100%; min-width: 0; max-width: 100%; }
.gestione-scarichi-container .filtri label.filter-item > div > div { min-width: 0; }
.gestione-scarichi-container .filtri label.filter-item > div [class$="-value-container"] { min-width: 0; overflow: hidden; }
.gestione-scarichi-container .filtri label.filter-item > div [class$="-singleValue"] { max-width: calc(100% - 8px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gestione-scarichi-container .filtri .react-datepicker-wrapper,
.gestione-scarichi-container .filtri .react-datepicker__input-container { display: block; width: 100%; min-width: 0; }
.gestione-scarichi-container .filtri-group {
  display: grid; grid-template-columns: minmax(0,1fr); gap: 12px; align-items: start;
  width: 100%; margin: 0; padding: 12px; border: 1px solid #dbe5ec; border-radius: 9px; background: #f7fafc;
}
.gestione-scarichi-container .filtri-group label { display: block; margin-bottom: 5px; color: #34495e; font-size: 13px; font-weight: 650; }
.gestione-scarichi-container .filtri-group input,
.gestione-scarichi-container .filtri-group select { max-width: 100%; }
.gestione-scarichi-container .filtri-group .react-select__control { min-height: 40px; border-color: #cbd5e1; border-radius: 7px; }
.gestione-scarichi-container .filtri-group .react-select__control:hover { border-color: var(--mf-primary); }

/* Tabella movimenti */
.gestione-scarichi-container .tabella-scarichi {
  width: 100%; border-collapse: separate; border-spacing: 0; margin: 16px 0 22px;
  overflow: hidden; border: 1px solid #d8e2e9; border-radius: 11px; background: #fff;
  box-shadow: 0 4px 16px rgba(22,55,78,.06); font-size: 13px;
}
.gestione-scarichi-container .tabella-scarichi th {
  position: sticky; top: 0; z-index: 1; padding: 12px 10px;
  border-bottom: 1px solid #174664; background: #1e5a80; color: #fff;
  font-size: 12px; font-weight: 700; line-height: 1.35; text-align: left; white-space: nowrap;
}
.gestione-scarichi-container .tabella-scarichi td { padding: 10px; border-bottom: 1px solid #e7edf1; color: #34495e; vertical-align: middle; }
.gestione-scarichi-container .tabella-scarichi tbody tr:last-child td { border-bottom: 0; }
.gestione-scarichi-container .tabella-scarichi tbody tr:hover { filter: brightness(.98); }
.gestione-scarichi-container .tabella-scarichi tbody tr { cursor: pointer; }
.gestione-scarichi-container .tabella-scarichi tr.selected { background: #dceef7; }

/* Tabelle dentro ai prospetti e alle fatture */
.gestione-scarichi-container .scarichi-tabella-documento {
  width: 100%; border-collapse: collapse; margin-top: 10px; background: #fff; color: #334b5d; font-size: 13px;
}
.gestione-scarichi-container .scarichi-tabella-documento th {
  padding: 10px; border: 1px solid #d8e2e9; background: #1e5a80; color: #fff; text-align: left;
}
.gestione-scarichi-container .scarichi-tabella-documento td { padding: 9px 10px; border: 1px solid #d8e2e9; }
.gestione-scarichi-container .scarichi-tabella-documento tbody tr:nth-child(even) { background: #f7fafc; }

/* Modali: gli stili inline preesistenti restano rispettati, questi uniformano i controlli */
.gestione-scarichi-container [role="dialog"],
.gestione-scarichi-container .modal,
.gestione-scarichi-container [class*="modal"] {
  color: var(--mf-text);
}
.gestione-scarichi-container [class*="modal"] h2,
.gestione-scarichi-container [class*="modal"] h3 { color: #18384e; }
.gestione-scarichi-container [class*="modal"] label { color: #334b5d; font-weight: 600; }
.gestione-scarichi-container [class*="modal"] input:not([type="checkbox"]),
.gestione-scarichi-container [class*="modal"] select,
.gestione-scarichi-container [class*="modal"] textarea {
  max-width: 100%; min-height: 39px; padding: 8px 10px; border: 1px solid #cbd5df; border-radius: 7px; background: #fff; color: #263746;
}
.gestione-scarichi-container [class*="modal"] button {
  min-height: 38px; padding: 8px 13px; border: 1px solid var(--mf-primary); border-radius: 8px;
  background: var(--mf-primary); color: #fff; font-weight: 600; cursor: pointer;
}
.gestione-scarichi-container [class*="modal"] button:hover:not(:disabled) { background: var(--mf-primary-hover); }
.gestione-scarichi-container [class*="modal"] button:disabled { opacity: .55; cursor: not-allowed; }

@media (max-width: 1100px) {
  .gestione-scarichi-container .gestione-scarichi-toolbar { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .gestione-scarichi-container .filtri { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .gestione-scarichi-container .tabella-scarichi { display: block; overflow-x: auto; }
}
@media (max-width: 640px) {
  .gestione-scarichi-container { padding: 10px; }
  .gestione-scarichi-container .scarichi-brand { gap: 11px; padding: 14px; border-radius: 11px; }
  .gestione-scarichi-container .scarichi-logo { max-width: 58px; max-height: 48px; }
  .gestione-scarichi-container h2 { font-size: 1.25rem; }
  .gestione-scarichi-container .gestione-scarichi-toolbar { grid-template-columns: minmax(0,1fr); gap: 8px; }
  .gestione-scarichi-container .gestione-scarichi-toolbar button { min-height: 44px; }
  .gestione-scarichi-container .filtri { grid-template-columns: minmax(0,1fr); gap: 14px; padding: 12px; }
  .gestione-scarichi-container .filtri-group { padding: 10px; }
  .gestione-scarichi-container .filtri-attivi-card { padding: 12px; }
  .gestione-scarichi-container .scarichi-legend { gap: 9px 14px !important; padding: 10px; }
  .gestione-scarichi-container .tabella-scarichi { font-size: 12px; }
  .gestione-scarichi-container .tabella-scarichi th,
  .gestione-scarichi-container .tabella-scarichi td { padding: 8px; }
}
.movimenti-riepilogo {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.movimenti-semaforo {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ========================================
   METALFLOW - Campi fattura elettronica
   ======================================== */

.stile-label-fattura {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  color: #334155;
  font-size: 13px;
  font-weight: 600;
}

.stile-campo-fattura {
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 11px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #0f172a;
  font-size: 14px;
  font-weight: 400;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.stile-campo-fattura:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

.stile-campo-fattura:disabled {
  background: #f1f5f9;
  color: #64748b;
  cursor: not-allowed;
}

/* METALFLOW - integrazione grafica Gestione Scarichi */
.gestione-scarichi-container {
  --scarichi-primary: #245b86;
  --scarichi-primary-dark: #174365;
  --scarichi-border: #d7e0e8;
  --scarichi-muted: #64748b;
  --scarichi-surface: #ffffff;
  --scarichi-bg: #f3f6f9;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: clamp(14px, 2vw, 28px);
  color: #243447;
  background: var(--scarichi-bg);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}
.gestione-scarichi-container *, .gestione-scarichi-container *::before, .gestione-scarichi-container *::after { box-sizing: border-box; }
.scarichi-brand { display:flex; align-items:center; justify-content:center; gap:16px; margin:0 auto 20px; }
.scarichi-logo { max-width:76px; max-height:64px; object-fit:contain; }
.scarichi-title { margin:0; color:var(--scarichi-primary-dark); font-size:clamp(1.35rem,2.4vw,2rem); font-weight:750; letter-spacing:-.025em; }
.gestione-scarichi-toolbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; padding:14px; margin-bottom:16px; border:1px solid var(--scarichi-border); border-radius:14px; background:var(--scarichi-surface); box-shadow:0 3px 12px rgba(25,55,80,.06); }
.scarichi-btn, .gestione-scarichi-toolbar button, .filtri button { min-height:38px; padding:9px 14px; border:1px solid #cbd7e2; border-radius:8px; background:#fff; color:#24445e; font-weight:650; cursor:pointer; transition:background .15s,border-color .15s,transform .15s; }
.scarichi-btn:hover, .gestione-scarichi-toolbar button:hover, .filtri button:hover { background:#edf5fb; border-color:#8eabc2; }
.scarichi-btn:disabled, .gestione-scarichi-toolbar button:disabled { opacity:.48; cursor:not-allowed; }
.gestione-scarichi-toolbar .scarichi-btn-primary, .gestione-scarichi-toolbar button:last-child { background:var(--scarichi-primary); color:#fff; border-color:var(--scarichi-primary); }
.gestione-scarichi-toolbar .toolbar-logout { margin-left:auto; }
.scarichi-legend { display:flex; flex-wrap:wrap; gap:12px 22px; align-items:center; padding:12px 16px; margin:12px 0; border:1px solid var(--scarichi-border); border-radius:12px; background:#fff; font-size:13px; }
.scarichi-legend > div { display:flex; align-items:center; gap:7px; }
.filtri-attivi-card, .filtri { margin:12px 0 16px; padding:16px; border:1px solid var(--scarichi-border); border-radius:12px; background:#fff; box-shadow:0 2px 9px rgba(25,55,80,.04); }
.filtri-attivi-card { cursor:pointer; }
.filtri-attivi-titolo { display:flex; justify-content:space-between; gap:12px; color:var(--scarichi-primary-dark); }
.filtri-attivi-valori { margin-top:8px; color:var(--scarichi-muted); line-height:1.6; overflow-wrap:anywhere; }
.filtri { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; align-items:end; }
.filtri-group { display:flex; flex-wrap:wrap; gap:10px; }
.filtri-group > div { display:flex; flex-wrap:wrap; gap:10px; }
.filter-item { display:flex; flex-direction:column; align-items:stretch; gap:6px; min-width:0; color:#40556a; font-size:13px; font-weight:650; }
.filtri input:not([type="checkbox"]), .filtri select, .filtri-group input, .filtri-group .react-datepicker-wrapper, .filtri .react-select__control, .scarichi-modal input, .scarichi-modal select, .scarichi-modal textarea { width:100%; min-height:39px; padding:8px 10px; border:1px solid #cbd5df; border-radius:7px; background:#fff; color:#263849; font:inherit; }
.filtri .filter-item:has(input[type="checkbox"]) { flex-direction:row; align-items:center; justify-content:flex-start; }
.movimenti-riepilogo { display:flex; align-items:center; flex-wrap:wrap; gap:8px; padding:10px 14px; margin:14px 0 8px; border:1px solid var(--scarichi-border); border-radius:10px; background:#fff; color:#42566a; }
.scarichi-tabella-wrapper { width:100%; overflow:auto; border:1px solid var(--scarichi-border); border-radius:12px; background:#fff; box-shadow:0 3px 14px rgba(25,55,80,.05); }
.tabella-scarichi, .scarichi-tabella-documento { width:100%; border-collapse:separate; border-spacing:0; background:#fff; font-size:13px; }
.tabella-scarichi { min-width:1120px; margin:0; }
.tabella-scarichi th, .scarichi-tabella-documento th { position:sticky; top:0; z-index:1; padding:12px 10px; background:#eaf1f7; color:#254760; border-bottom:1px solid #d1dce6; text-align:left; white-space:nowrap; }
.tabella-scarichi th { cursor:pointer; }
.tabella-scarichi td, .scarichi-tabella-documento td { padding:10px; border-bottom:1px solid #e8edf2; vertical-align:middle; }
.tabella-scarichi tbody tr:hover { filter:brightness(.97); }
.tabella-scarichi tbody tr:last-child td, .scarichi-tabella-documento tbody tr:last-child td { border-bottom:0; }
.scarichi-modal-overlay { position:fixed; inset:0; z-index:99999; display:flex; align-items:center; justify-content:center; padding:20px; overflow:auto; background:rgba(12,27,40,.62); backdrop-filter:blur(3px); }
.scarichi-modal { width:min(1100px,100%); max-height:calc(100vh - 40px); overflow:auto; padding:clamp(16px,2.2vw,28px); border:1px solid rgba(255,255,255,.65); border-radius:16px; background:#fff; box-shadow:0 20px 65px rgba(0,0,0,.25); }
.scarichi-modal h2, .scarichi-modal h3 { color:var(--scarichi-primary-dark); margin-top:0; }
.scarichi-modal > div { min-width:0; }
.scarichi-modal .scarichi-btn { margin-top:8px; }
.scarichi-modal .scarichi-btn-primary { color:#fff; background:var(--scarichi-primary); border-color:var(--scarichi-primary); }
.stile-label-fattura { display:flex; flex-direction:column; gap:6px; color:#40556a; font-size:13px; font-weight:650; }
.stile-campo-fattura { width:100%; min-height:40px; padding:9px 11px; border:1px solid #cbd5df; border-radius:7px; background:#fff; }
.stile-campo-fattura:focus, .scarichi-modal input:focus, .scarichi-modal select:focus { outline:2px solid #b6d7f0; border-color:var(--scarichi-primary); }
@media (max-width:760px) {
 .gestione-scarichi-container { padding:10px; }
 .scarichi-brand { align-items:flex-start; justify-content:flex-start; }
 .scarichi-logo { max-width:54px; max-height:48px; }
 .gestione-scarichi-toolbar { padding:10px; }
 .gestione-scarichi-toolbar .toolbar-logout { margin-left:0; }
 .gestione-scarichi-toolbar button { flex:1 1 145px; }
 .scarichi-legend { gap:10px 14px; }
 .filtri { grid-template-columns:1fr; }
 .filtri-group > div { width:100%; }
 .scarichi-modal-overlay { align-items:flex-start; padding:10px; }
 .scarichi-modal { max-height:calc(100vh - 20px); border-radius:12px; }
}
